# Discord credentials — Developer Portal → General Information
DISCORD_APPLICATION_ID=
# Developer Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Optional: register slash commands to one guild for instant availability (global takes ~1h)
# DISCORD_GUILD_ID=

# Optional: invite link shown on the status page
# DISCORD_INSTALL_URL=

# Claude authentication (claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=

# Claude model for agentic replies
MODEL=claude-sonnet-5

# Optional: path to the claude CLI binary (default: resolved from PATH)
# CLAUDE_PATH=

BOT_USERNAME=Orb Of AI

# HTTP status server port (fly.toml pins 8080 in production)
# PORT=8080

# Coin economy (defaults shown)
# STARTING_COINS=100
# Daily check-in reward is a streak ladder in code (CHECKIN_SCHEDULE in
# src/commands/diemdanh.ts), not an env var — tune it there.
# STREAM_COINS_PER_BLOCK=10
# STREAM_BLOCK_MINUTES=5

# World Cup betting (/worldcup) — the whole feature stays off until the token is
# set (free tier at football-data.org covers competition WC)
# FOOTBALL_DATA_TOKEN=
# BET_TICKET_FEE=10

# Path of Exile — OAuth cho cả PoE1 + PoE2. KHÔNG cần env nào để chạy:
# mặc định dùng public client của Path of Building (client_id=pob, không cần đăng ký
# GGG), user mở /poe bấm Kết nối → authorize → dán code. Token store mã hoá bằng key
# suy ra từ DISCORD_BOT_TOKEN.
#
# Nâng cấp (tuỳ chọn) sang confidential client riêng: set đủ 3 biến dưới (đăng ký qua
# oauth@grindinggear.com; redirect HTTPS trên domain đã đăng ký, path do server.ts
# serve) → flow đổi sang web callback sạch, không cần bước dán code.
# POE_CLIENT_ID=
# POE_CLIENT_SECRET=
# POE_REDIRECT_URI=https://localhost-8080.aiocean.dev/oauth/poe/callback
# POE_CONTACT_EMAIL=

# DiscordHero save oracles (local-only dev tools) — the EasySave3 password that
# ships inside the TaskbarHero binary; ask the maintainer. Not needed by the bot.
# TASKBARHERO_ES3_PASSWORD=
