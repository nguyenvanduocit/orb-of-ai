{
  "name": "discord-claude-bot",
  "version": "1.0.0",
  "description": "Orb Of AI — Discord bot powered by discord.js + Claude Agent SDK",
  "type": "module",
  "scripts": {
    "start": "bun --env-file=.env run src/index.ts",
    "dev": "bun --env-file=.env run --watch src/index.ts",
    "register": "bun --env-file=.env run src/register.ts",
    "emojis:gen": "bun run scripts/gen-cards.ts",
    "emojis:upload": "bun --env-file=.env run scripts/upload-emojis.ts",
    "items:gen": "bun run scripts/gen-items.ts",
    "taskbarhero:fetch": "bun run scripts/taskbarhero-data.ts --fetch",
    "taskbarhero:publish": "bun run scripts/taskbarhero-data.ts --publish",
    "discordhero:catalog:generate":"bun run scripts/discordhero-catalog.ts --generate",
    "discordhero:catalog:check": "bun run scripts/discordhero-catalog.ts --check",
    "discordhero:achievements:generate": "bun run scripts/discordhero-achievements.ts --generate",
    "discordhero:achievements:check": "bun run scripts/discordhero-achievements.ts --check",
    "discordhero:community-market:generate": "bun run scripts/discordhero-community-market.ts --generate",
    "discordhero:community-market:check": "bun run scripts/discordhero-community-market.ts --check",
    "discordhero:community-content:generate": "bun run scripts/discordhero-community-content.ts --generate",
    "discordhero:community-content:check": "bun run scripts/discordhero-community-content.ts --check",
    "discordhero:oracle:save:snapshot": "bun run scripts/discordhero-save-snapshot.ts",
    "discordhero:oracle:pet-arrangement:capture": "bun run scripts/discordhero-pet-arrangement-oracle.ts",
    "discordhero:oracle:campaign:discover": "bun run scripts/discordhero-campaign-save-delta.ts",
    "test:mcp": "bun --env-file=.env run src/mcp-test.ts",
    "rpg:stats": "bun run src/rpg-telemetry-report.ts",
    "rpg:sandbox": "bun run src/rpg-sandbox.ts",
    "rpg:retier": "bun run src/migrate-jackpot-tiers.ts",
    "typecheck": "bunx tsc --noEmit",
    "deploy": "fly deploy --remote-only --ha=false",
    "logs": "fly logs --app orb-of-ai"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.198",
    "discord.js": "^14.26.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "prettier": "3.9.6",
    "typescript": "^5.9.0"
  }
}
